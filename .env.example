# Copie este arquivo para .env e ajuste os valores.
# Nunca envie o arquivo .env para o repositório.

DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-longa
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Em branco = SQLite local (desenvolvimento).
# Em produção (Render/Railway), informe a URL do PostgreSQL gerenciado:
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
DATABASE_URL=

# Produção (DJANGO_DEBUG=0): a chave secreta é obrigatória.
# No Render, o domínio é lido automaticamente de RENDER_EXTERNAL_HOSTNAME.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://seu-app.onrender.com
# DJANGO_SECURE_SSL_REDIRECT=1
